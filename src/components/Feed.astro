---
// Feed component: renders a single domain's list of feed items.
// Props:
// - `domain`: string identifier for the feed (used as heading and anchor id).
// - `feed`: array of feed items as returned by the backend API.
import { shortTimeAgo } from "../utils/time";

const { domain, feed } = Astro.props;
---

<div class="max-w-prose border-b-primary pb-2 border-b-2 w-full" id={domain}>
  <h2
    class="mb-1 text-center underline-offset-3 tracking-wide font-bold text-xl font-oswald"
  >
    {domain}
  </h2>
  <ul class="list-disc list-inside" data-feed-list>
    {
      feed.map((item: any, index: number) => (
        <li
          class="prose"
          data-feed-item={index}
          hidden={index >= 10}
        >
          <>
            <a href={item.link}>{item.title}</a>
            {item.pubDate && <span>[{shortTimeAgo(item.pubDate)}]</span>}
          </>
        </li>
      ))
    }
  </ul>
</div>
