---
import Layout from "../layouts/Layout.astro";
import { getCategories } from "../utils/api";

const categories = await getCategories();
---

<Layout>
  <header class="prose mx-auto text-center">
    <h1 class="text-4xl font-oswald">FreshFeeds</h1>
    <p class="text-base max-w-prose mx-auto">
      A lightweight RSS reader aggregating feeds by category. Click any category
      to browse its latest items.
    </p>
  </header>

  <section class="mt-6">
    {
      categories?.length ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            categories.map((category) => {
              return (
                <a href={`/${category.name}`} class="category-card card">
                  <div class="flex items-center justify-between">
                    <div>
                      <h3 class="title text-lg capitalize">
                        {category.name.replace(/_/g, " ")}
                      </h3>
                      <p class="text-sm">{category.feedCount} feeds</p>
                    </div>
                    <div class="text-sm small-muted">↗</div>
                  </div>
                  <p class="mt-2 text-sm text-base-content opacity-80">
                    {category.sampleDomains.join(", ")}
                  </p>
                </a>
              );
            })
          }
        </div>
      ) : (
        <p class="text-center text-sm opacity-70">
          Unable to load categories. Make sure the backend is running and
          PUBLIC_API_URL points to it.
        </p>
      )
    }
  </section>
</Layout>
