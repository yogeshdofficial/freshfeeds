---
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import Feed from "../components/Feed.astro";
import DomainChooser from "../components/DomainChooser.astro";
import { getCategories, getCategoryFeeds } from "../utils/api";

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  if (!categories) {
    console.error("Backend API unreachable - cannot prerender category pages.");
    return [];
  }
  return categories.map((category) => {
    return { params: { category: category.name } };
  });
}) satisfies GetStaticPaths;

const { category }: { category: string } = Astro.params;

const data = await getCategoryFeeds(category);
const domains = data ? Object.keys(data.feeds) : [];
---

<Layout>
  <div class="flex flex-col gap-3 items-center min-w-0">
    <DomainChooser domains={domains} />
    {
      data
        ? domains.map((domain) => {
            return <Feed domain={domain} feed={data.feeds[domain]} />;
          })
        : (
            <p class="text-sm opacity-70">
              Unable to load feeds for {category}. Make sure the backend is
              running and PUBLIC_API_URL points to it.
            </p>
          )
    }
  </div>
</Layout>
